# Copy to .env and fill in. .env is gitignored — never commit real keys.

DATABASE_URL="postgresql://billing:billing@localhost:5433/billing"
# Integration tests TRUNCATE tables, so they use their own database. Falls back to DATABASE_URL (as in CI).
TEST_DATABASE_URL="postgresql://billing:billing@localhost:5433/billing_test"

# Stripe TEST MODE keys only (sk_test_..., pk_test_...). The app refuses to start with a live key.
STRIPE_SECRET_KEY="sk_test_..."
# Printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional: printed by `pnpm stripe:setup`. Falls back to the account's default portal configuration.
STRIPE_PORTAL_CONFIGURATION_ID=""

APP_URL="http://localhost:3000"

# Signs the demo session cookie. Any long random string: `openssl rand -hex 32`
SESSION_SECRET="change-me-to-a-long-random-string"

# Comma-separated emails allowed into /admin
ADMIN_EMAILS="admin@example.com"

# Public demo only: open /admin to every visitor, read-only, with emails and personal data masked.
# Sign-in is passwordless, so on a public deployment the allowlist alone protects nothing.
DEMO_ADMIN_OPEN=""
